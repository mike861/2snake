#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
贪吃蛇游戏主入口 - 支持单机双人和在线对战模式
"""

from kivy.app import App
from kivy.uix.screenmanager import ScreenManager, Screen
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.button import Button
from kivy.uix.label import Label
from kivy.core.window import Window

import os
import sys
import importlib.util

# 检测文件是否存在
def module_exists(module_path):
    return os.path.exists(module_path)

# 动态导入模块
def import_module(module_name, module_path):
    spec = importlib.util.spec_from_file_location(module_name, module_path)
    if spec is None:
        return None
    module = importlib.util.module_from_spec(spec)
    sys.modules[module_name] = module
    spec.loader.exec_module(module)
    return module

# 本地游戏模块
offline_game_module = None
if module_exists(os.path.join(os.path.dirname(__file__), 'offline_game.py')):
    offline_game_module = import_module('offline_game', os.path.join(os.path.dirname(__file__), 'offline_game.py'))
else:
    # 如果没有offline_game.py，使用原来的main.py内容作为离线游戏
    if os.path.exists(os.path.join(os.path.dirname(__file__), 'main.py.bak')):
        import shutil
        # 复制main.py.bak到offline_game.py
        shutil.copyfile(
            os.path.join(os.path.dirname(__file__), 'main.py.bak'),
            os.path.join(os.path.dirname(__file__), 'offline_game.py')
        )
        offline_game_module = import_module('offline_game', os.path.join(os.path.dirname(__file__), 'offline_game.py'))

# 在线游戏模块
online_game_module = None
if module_exists(os.path.join(os.path.dirname(__file__), 'client_game.py')):
    online_game_module = import_module('client_game', os.path.join(os.path.dirname(__file__), 'client_game.py'))

class MenuScreen(Screen):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        
        # 创建布局
        layout = BoxLayout(orientation='vertical', padding=50, spacing=20)
        
        # 标题
        title = Label(
            text='贪吃蛇游戏', 
            font_size=36,
            size_hint_y=None, 
            height=100
        )
        layout.add_widget(title)
        
        # 创建按钮
        if offline_game_module:
            offline_btn = Button(
                text='单机双人模式',
                size_hint_y=None,
                height=60,
                font_size=24
            )
            offline_btn.bind(on_press=self.start_offline_game)
            layout.add_widget(offline_btn)
        
        if online_game_module:
            online_btn = Button(
                text='在线对战模式',
                size_hint_y=None,
                height=60,
                font_size=24
            )
            online_btn.bind(on_press=self.start_online_game)
            layout.add_widget(online_btn)
        
        # 退出按钮
        exit_btn = Button(
            text='退出游戏',
            size_hint_y=None,
            height=60,
            font_size=24
        )
        exit_btn.bind(on_press=self.exit_game)
        layout.add_widget(exit_btn)
        
        self.add_widget(layout)
    
    def start_offline_game(self, instance):
        if offline_game_module and hasattr(offline_game_module, 'SnakeApp'):
            offline_game_module.SnakeApp().run()
    
    def start_online_game(self, instance):
        if online_game_module and hasattr(online_game_module, 'OnlineSnakeApp'):
            online_game_module.OnlineSnakeApp().run()
    
    def exit_game(self, instance):
        App.get_running_app().stop()

class SnakeMenuApp(App):
    def build(self):
        # 设置窗口
        Window.size = (600, 400)
        self.title = '贪吃蛇游戏选择器'
        
        # 创建屏幕管理器
        sm = ScreenManager()
        sm.add_widget(MenuScreen(name='menu'))
        
        return sm

if __name__ == '__main__':
    SnakeMenuApp().run() 